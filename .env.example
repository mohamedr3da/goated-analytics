# Required for running the local Discord gateway bot.
DISCORD_TOKEN=

# Use "mock" for offline/local development, "x_api" for official X API data,
# or "scraper" for the experimental unauthenticated public-page proof of concept.
X_PROVIDER_MODE=mock
X_BEARER_TOKEN=

DATABASE_URL=sqlite+aiosqlite:///./data/x_analytics.db

COLLECTION_INTERVAL_MINUTES=60
X_RECENT_POSTS_LIMIT=20
X_INITIAL_BACKFILL_DAYS=30
X_INITIAL_BACKFILL_MAX_POSTS=200
X_REQUEST_TIMEOUT_SECONDS=20
X_MAX_RETRIES=3
X_MAX_CONCURRENCY=2

AUTHORIZED_DISCORD_USER_IDS=
AUTHORIZED_DISCORD_ROLE_IDS=
PUBLIC_ANALYTICS_ENABLED=true
LOG_LEVEL=INFO
